# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID. Comma-separated for multiple.
# Get it from @userinfobot. This is the only thing gating shell access — set it.
ALLOWED_USER_IDS=

# Where codex runs by default
DEFAULT_WORKSPACE=/root/workspace

# /cd cannot escape this. Keep the public default scoped to the workspace.
WORKSPACE_ROOT=/root/workspace

# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write

# Optional model pin, e.g. gpt-5-codex. Empty = Codex default.
CODEX_MODEL=

# Optional reasoning effort. Individual chats can override with /effort.
# none | minimal | low | medium | high | xhigh | max | ultra
CODEX_REASONING_EFFORT=

CODEX_BIN=codex
# app-server enables Telegram approval buttons; exec is the compatibility fallback.
CODEX_BACKEND=app-server
DB_PATH=./data/sessions.db

# Hidden semantic routing is independent from the conversational model.
# Skills the automatic router may start, as a JSON catalog (see
# skills.example.json). Leave empty to disable automatic routing; explicit
# `$skill-name` invocations keep working either way.
SKILL_CATALOG_FILE=

# Cosmetic labels for the two sides of a transcript in hidden prompts.
USER_DISPLAY_NAME=User
ASSISTANT_DISPLAY_NAME=Assistant

SKILL_ROUTER_ENABLED=true
SKILL_ROUTER_MODEL=
SKILL_ROUTER_EFFORT=low

# IANA timezone used for trusted per-message timestamps passed to Codex.
USER_TIMEZONE=UTC

# Runaway guard, not a latency target. 15 min.
TURN_TIMEOUT_MS=900000
APPROVAL_TIMEOUT_MS=300000

# Hidden skill routing must never keep a Telegram chat active indefinitely.
SKILL_ROUTER_TIMEOUT_MS=15000

# How many of the user's own earlier messages the skill router may read.
# Assistant replies are never included. 0 routes on the current message alone.
SKILL_ROUTER_HISTORY_TURNS=3
# Earlier messages older than this are dropped, so an overnight gap cannot leave
# the previous scene in the routing window. 0 disables the cutoff.
SKILL_ROUTER_HISTORY_WINDOW_MS=1800000

# Bridge-only portrait. Fixed files and the current MEMORY_FILE snapshot anchor
# each new thread/compaction window; the hidden reviewer may update MEMORY_FILE
# without re-injecting it into the live window.
PROFILE_FILES=~/.codex-tg/AGENTS.md
MEMORY_FILE=~/.codex-tg/MEMORY.md
MEMORY_REVIEW_INTERVAL=10
MEMORY_MAX_CHARS=2000
MEMORY_REVIEW_MODEL=
MEMORY_REVIEW_EFFORT=low
MEMORY_REVIEW_WORKSPACE=/root/workspace

# Carry the immediately previous thread's last user turns into a fresh /new
# thread once. /new clean always skips this continuity excerpt.
RECENT_THREAD_CONTEXT_ENABLED=true
RECENT_THREAD_CONTEXT_TURNS=10
RECENT_THREAD_CONTEXT_MAX_CHARS=24000

# Optional hidden daily Journal event collector. It requires an MCP server that
# exposes Memory Gateway's append_journal tool. It cuts the day at 03:00 and
# starts at 03:03 in this IANA timezone.
JOURNAL_COLLECTOR_ENABLED=false
JOURNAL_COLLECTOR_TASK_NAME=daily-journal-event-collector
JOURNAL_COLLECTOR_TIMEZONE=UTC
JOURNAL_COLLECTOR_MODEL=
JOURNAL_COLLECTOR_EFFORT=low
JOURNAL_COLLECTOR_WORKSPACE=/root/workspace
JOURNAL_COLLECTOR_BATCH_CHARS=120000

# Hidden adaptive wake opportunities: the assistant may start a turn on its own
# and send one Telegram message. Exact appointments outrank flexible windows;
# PROACTIVE_WAKE_FALLBACK_MINUTES supplies the ordinary default rhythm.
PROACTIVE_WAKE_ENABLED=true
PROACTIVE_WAKE_CHAT_ID=
PROACTIVE_WAKE_TOPIC_ID=
PROACTIVE_WAKE_TIMEZONE=UTC
PROACTIVE_WAKE_START_HOUR=10
PROACTIVE_WAKE_END_HOUR=22
PROACTIVE_WAKE_MIN_MINUTES=10
PROACTIVE_WAKE_MAX_MINUTES=1440
PROACTIVE_WAKE_FALLBACK_MINUTES=120
PROACTIVE_WAKE_BOOTSTRAP_MINUTES=60
PROACTIVE_WAKE_USER_QUIET_MINUTES=15
PROACTIVE_WAKE_LEASE_MS=1200000

# Telegram attachment transport. Defaults: 5 inputs, 20 MiB each / 40 MiB total;
# 5 outputs, 45 MiB each / 90 MiB total; cleanup after 15 minutes.
MAX_ATTACHMENT_FILES=5
MAX_ATTACHMENT_BYTES=20971520
MAX_ATTACHMENT_TOTAL_BYTES=41943040
MAX_OUTPUT_FILES=5
MAX_OUTPUT_FILE_BYTES=47185920
MAX_OUTPUT_TOTAL_BYTES=94371840
ATTACHMENT_RETENTION_MS=900000

# Long responses containing substantial code are returned as Markdown documents.
CODE_AS_FILE_MIN_CHARS=3000

# Hold a completed assistant answer briefly so a boundary-racing user message
# can supersede it without creating two visible replies. Model work starts immediately.
RESPONSE_COMMIT_GRACE_MS=800

# false: tool calls collapse into one self-updating status line that is deleted
#        when the turn ends, so only the agent's own messages persist.
# true:  one message per tool call, with full command output. Debugging mode.
SHOW_TOOL_CALLS=false
